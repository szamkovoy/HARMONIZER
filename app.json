{
  "expo": {
    "name": "Harmonizer",
    "slug": "harmonizer",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.zamkovoi.harmonizer.app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/splash.png",
        "backgroundColor": "#ffffff",
        "resizeMode": "cover"
      }
    },
    "ios": {
      "bundleIdentifier": "com.zamkovoi.harmonizer.app",
      "buildNumber": "17",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Harmonizer использует камеру для режимов BIOFEEDBACK.",
        "NSMicrophoneUsageDescription": "Harmonizer использует микрофон для голосовых сообщений в чате.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "appleTeamId": "T59BVP7L9H"
    },
    "android": {
      "package": "com.zamkovoi.harmonizer",
      "versionCode": 58,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true,
          "imageWidth": 288,
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#ffffff",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Harmonizer использует камеру для режимов BIOFEEDBACK."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Harmonizer использует микрофон для голосовых сообщений в чате."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Harmonizer использует камеру для режимов BIOFEEDBACK.",
          "enableFrameProcessors": true
        }
      ],
      "./plugins/with-ios-automatic-signing.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Harmonizer использует доступ к фото, чтобы вы могли приложить скриншот в поддержку."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f70cebc4-c303-45f8-87c8-694daa3e1981"
      }
    }
  }
}
