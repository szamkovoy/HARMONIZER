# Скопируйте в `.env.local` и заполните локально. Файлы `.env.local` в git не коммитятся.

# ─── Expo / мобильный клиент ────────────────────────────────────────────────
# URL origin развёрнутого `_legacy_web` с маршрутом /api/communicator (диалог, транскрипция, калибровка…)
EXPO_PUBLIC_COMMUNICATOR_API_URL=https://harmonizer-ten.vercel.app
# Product QA UI (tier switch, day reset, dialog export, diagnostics, model badges…).
# true = internal/test build; false/absent = end-user release (do not rely on __DEV__).
EXPO_PUBLIC_HARMONIZER_TEST_MODE=true
# i18n voice QA only (separate from HARMONIZER_TEST_MODE).
EXPO_PUBLIC_I18N_TEST_MODE=true
EXPO_PUBLIC_COMMUNICATOR_TEXT_MODE_ENABLED=false
# Подпись в тестовом бейдже ассистента, если ещё нет modelUsed с сервера; тариф берётся из профиля.
EXPO_PUBLIC_COMMUNICATOR_MODEL_LABEL=standard

# Опционально: полный URL дневного прогноза (иначе при наличии EXPO_PUBLIC_SUPABASE_URL
# клиент ходит в Edge Function `daily-forecast`: …/functions/v1/daily-forecast).
# EXPO_PUBLIC_DAILY_FORECAST_URL=

# Supabase — клиентские ключи (публичные)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (см. Google Cloud Console → APIs & Services → Credentials)
# Если Supabase ругается на nonce при нативном Google на iOS — в Dashboard → Auth →
# Google включите «Skip nonce check» (см. modules/auth/sign-in-google.ts).
# Web Client ID — тот же, что указан в Supabase Dashboard → Auth → Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS Client ID — для GoogleSignin.configure на iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Опционально: обратный iOS Client ID для URL Schemes при prebuild.
# Если пусто — app.config.ts выведет схему из EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Google Maps SDK (Android only — «Проверить на карте» в мастере / Профиле).
# Google Cloud → Maps SDK for Android → API key; нужен native rebuild после добавления.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (клиентский DSN)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Hume (эмоции в голосе) — клиентский ключ (dev-only; для prod перенесём на бэкенд)
EXPO_PUBLIC_HUME_API_KEY=

# ─── Supabase admin (локальные миграции, cron через CLI) ────────────────────
# Все значения ТОЛЬКО в .env.local, НЕ коммитить
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# ─── Next.js (_legacy_web/), дублируется в _legacy_web/.env.local ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio / Gemini (серверный ключ, НЕ NEXT_PUBLIC)
# GEMINI_API_KEY=
# Реальные id см. https://ai.google.dev/gemini-api/docs/gemini-3 (суффикс -preview для Gemini 3).
# Короткие имена gemini-3.1-flash / gemini-3.1-pro на стороне API нормализуются в _utils/gemini.ts.
# Опционально: ALLOW_LEGACY_GEMINI_MODELS=true — подменять gemini-1.5-* на 2.5 при миграции.
AI_MODEL_STANDARD=gemini-2.0-flash
AI_MODEL_PREMIUM=gemini-3-flash-preview
AI_MODEL_FALLBACK=gemini-2.5-flash
MAX_DIALOG_LENGTH=9
# Автоматически при 503/429 и исчерпании основной модели (см. _legacy_web/app/api/_utils/gemini.ts).
GEMINI_TIMEOUT_MS=90000
SENTRY_DSN=https://fa0cbb049716d242310a11464f1684e2@o4511304250884096.ingest.de.sentry.io/4511304290533456
SENTRY_TRACES_SAMPLE_RATE=0.05

# Test mode — только сервер Next.js (_legacy_web), не на проде без необходимости
# TEST_MODE_FAST_INTERVALS=1
# TEST_MODE_TIME_DIVISOR=600
# TEST_MODE_FORCE_PHASE=morning
# DEBUG_DIALOG_EXPORT=1

# Прочие серверные ключи
HUME_API_KEY=
OPENAI_API_KEY=
# Защита cron-эндпоинтов /api/cron/* (дёргает только Vercel Cron с этим токеном)
CRON_SECRET=

# ─── Email transport (OTP + marketing) ───────────────────────────────────────
# Канон: docs/04_workspace/email_providers.md
# Profiles (same set for both vars):
#   RESEND_ZAMKOVOI_RU | RESEND_ZAMKOVOI_YOGA | AMAZON_ZAMKOVOI_RU | AMAZON_ZAMKOVOI_YOGA
# Production defaults (2026-07-30):
EMAIL_OTP=AMAZON_ZAMKOVOI_YOGA
EMAIL_MARKETING=RESEND_ZAMKOVOI_RU
# Legacy OTP fallback if EMAIL_OTP unset: AUTH_EMAIL_PROVIDER=resend|ses
# AUTH_EMAIL_PROVIDER=ses
RESEND_ZAMKOVOI_YOGA_API_KEY=
RESEND_ZAMKOVOI_RU_API_KEY=
MAIL_FROM_EMAIL=sergei@zamkovoi.yoga
# MAIL_MARKETING_FROM_EMAIL=sergei@zamkovoi.ru
# Amazon SES (Supabase secrets for OTP + Vercel for marketing when AMAZON_*):
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=eu-west-1
# OTP config set only (Supabase) — never reuse marketing set / no List-Unsubscribe:
# SES_OTP_CONFIGURATION_SET=harmonizer-otp
# Marketing config set (Vercel) when EMAIL_MARKETING=AMAZON_*:
# SES_CONFIGURATION_SET=harmonizer-marketing
# SES_MARKETING_WEBHOOK_SECRET=
# RESEND_MARKETING_WEBHOOK_SECRET=
# SEND_EMAIL_HOOK_SECRET=  # Supabase Auth → Send Email hook
