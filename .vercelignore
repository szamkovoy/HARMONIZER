# Lean uploads for `vercel deploy` from monorepo root (Vercel Root Directory = _legacy_web).
# Keep the Expo/iOS/Android app out of CLI uploads; dependencies are reinstalled on Vercel.
.git
**/.git
.vercel
**/.vercel
node_modules
**/node_modules
.next
**/.next
out
**/out
**/.env*
**/Apple_AuthKey*.p8

/android
/ios
/dist
/.expo
/app
/assets
/components
/constants
/docs
# Server (`_legacy_web` API) imports from repo-root `modules/` — keep i18n slices needed at build time.
# Ignore RN-only module trees to keep CLI uploads lean.
/modules/breath/core
/modules/breath/ui
/modules/breath/debug
/modules/communicator
/modules/mandala
/modules/ui
/plugins
/scripts
/services
/supabase
/.tmp_ocr
/__tmp_ocr
