{
  "name": "harmonizer",
  "main": "expo-router/entry",
  "version": "1.2.1",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "android:dev-client": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild:ios": "expo prebuild -p ios",
    "build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "check:eas-env": "node scripts/check-eas-client-env.mjs",
    "doctor:ios:biofeedback": "./scripts/doctor-ios-biofeedback.sh",
    "build:android:dev": "npm run check:eas-env -- development && npx eas-cli build --platform android --profile development --local --output dist/harmonizer-development.apk",
    "build:android:prod": "npm run check:eas-env -- production && npx eas-cli build --platform android --profile production --local --output dist/harmonizer-production.aab",
    "build:ios:dev:local": "npm run check:eas-env -- development && node scripts/refresh-cocoapods-appcheck-cdn.mjs && EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli build --platform ios --profile development --local --output dist/harmonizer-development.ipa",
    "build:ios:prod": "npm run check:eas-env -- production && node scripts/refresh-cocoapods-appcheck-cdn.mjs && EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli build --platform ios --profile production --local --output dist/harmonizer-production.ipa",
    "submit:android": "npx eas-cli submit --platform android --path dist/harmonizer-production.aab",
    "submit:ios": "npx eas-cli submit --platform ios --path dist/harmonizer-production.ipa",
    "web": "expo start --web",
    "test": "vitest run",
    "deploy:vercel": "vercel --prod --yes",
    "eas-build-post-install": "node scripts/refresh-cocoapods-appcheck-cdn.mjs"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "@react-native-firebase/app": "^26.0.0",
    "@react-native-firebase/app-check": "^26.0.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.9.2",
    "@sfourdrinier/react-native-ble-plx": "^3.7.10",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.101.1",
    "astronomia": "^4.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.11",
    "harmonizer-biofeedback-finger-frame-processor": "file:modules/biofeedback-finger-frame-processor",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/luxon": "^3.7.1",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vercel": "^56.3.2",
    "vitest": "^4.1.5"
  },
  "private": true
}
